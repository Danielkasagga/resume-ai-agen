{
  "name": "talentloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "api": "node server/index.mjs",
    "dev:all": "concurrently -k \"npm run api\" \"npm run dev\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "node server/index.mjs",
    "start": "npm run dev:all",
    "start:prod": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^9.2.4"
  }
}
