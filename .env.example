# ---------------------------------------------------------------------------
# TalentLoop configuration
# Copy this file to `.env` and fill in values as needed.
#
# The dashboard works out of the box WITHOUT any of these — the assessment
# questions, rubric, resume evidence, and scores are deterministic. These
# settings only enable optional live-AI features on the API server.
# ---------------------------------------------------------------------------

# Optional: enables OpenAI-backed question generation and answer grading on the
# API server. Leave empty to use the deterministic demo logic.
OPENAI_API_KEY=

# Optional: which OpenAI model to use for question generation / grading.
OPENAI_MODEL=gpt-4.1-mini

# Port the API server (and production server) listens on.
API_PORT=8792
